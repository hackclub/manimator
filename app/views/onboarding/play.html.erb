<% content_for :title, "Start · Manimator" %>

<%# Onboarding as the editor scaled down (a demo next to the pledge). Your answers are lines of your first scene: π
    drops where you click, your idea is a Text, your schedule is a plot, and signing plays the whole thing. Nothing is
    saved yet. %>
<div class="play" data-controller="play"
     data-play-poses-value="<%= pi_pose_urls %>"
     data-play-prizes-value="<%= onboarding_prizes.map { |p| p.slice(:id, :name, :videos).merge(image: image_path(p[:image])) }.to_json %>"
     data-play-for-value="<%= onboarding_for.map { |key, who| { key:, label: who[:pledge] } }.to_json %>"
     data-play-slots-value="<%= onboarding_when.to_json %>"
     data-play-days-value="<%= onboarding_days.to_json %>"
     data-play-sessions-value="<%= onboarding_sessions.keys.to_json %>"
     data-play-classes-value="<%= onboarding_classes.map { |key, c| { key:, label: c[:label] } }.to_json %>"
     data-play-draw-url-value="<%= draw_ideas_path %>"
     data-play-hours-value="<%= Pledge::HOURS_PER_VIDEO %>">
  <header class="play__bar">
    <%= link_to "Manimator", root_path, class: "onboard__brand" %>
    <span class="onboard__slash">/</span>
    <span class="play__file">first_scene.py</span>
  </header>

  <main class="play__main">
    <section class="play__code" data-play-target="code" aria-label="Your first scene, as code"></section>

    <section class="play__stage-wrap">
      <div class="play__stage" data-play-target="stage">
        <canvas data-play-target="canvas" aria-hidden="true"
                data-action="pointermove->play#aim pointerleave->play#unaim click->play#drop"></canvas>
      </div>
      <a class="btn btn--primary play__open" href="<%= editor_path %>" data-play-target="open" hidden>Open in the editor →</a>
    </section>
  </main>

  <footer class="play__timeline">
    <button class="play__run" data-play-target="run" data-action="play#replay" aria-label="Play the scene from the start">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10l8-5z"/></svg>
    </button>
    <div class="play__track" data-play-target="track" data-action="pointerdown->play#seek"></div>
    <span class="play__time mono-xs" data-play-target="time">0:00.0</span>
  </footer>
</div>

<%= render "onboarding/player" %>
