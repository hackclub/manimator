<%# Dev-only: jump between the onboarding variants. Each link goes back through /start, so it also sets the cookie. %>
<% if Rails.env.development? %>
  <nav class="onboarding-switcher">
    <span>onboarding:</span>
    <% current = cookies[Onboarding::COOKIE] %>
    <% Onboarding::VARIANTS.each do |variant, what| %>
      <%= link_to variant, onboarding_path(variant:), title: what, aria: { current: (variant == current) } %>
    <% end %>
  </nav>
<% end %>
