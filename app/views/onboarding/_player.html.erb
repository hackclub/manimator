<%# Music in the corner, as a CD drawn the way manim draws. Its rim is a circle, the 1:1 Lissajous figure; press play
    and it morphs through the figures of musical intervals (disc_controller), and back into a disc on pause. The music is
    the landing page's piano bed, looped: it starts with the page when you arrived by a click, else on your first click,
    unless you turned sound off. Hover for the track's name. %>
<div class="player" data-controller="sound disc" data-sound-player-value="true" data-sound-bed-value="<%= audio_path "bed.mp3" %>"
     data-playing="false" data-action="sound:change->disc#change">
  <div class="player__card">
    <span class="player__title">Late-night proof</span>
    <span class="player__caption" data-disc-target="caption">felt piano · 1:1 is a circle</span>
  </div>
  <button class="player__disc" aria-pressed="false" aria-label="Play music" data-sound-target="toggle" data-action="sound#toggle">
    <svg viewBox="0 0 96 96" aria-hidden="true">
      <circle class="player__face" cx="48" cy="48" r="47"/>
      <g class="player__shine">
        <path d="M13 32A38 38 0 0 1 33 12" stroke="var(--teal)"/>
        <path d="M20 36A30 30 0 0 1 36 19" stroke="var(--green)"/>
        <path d="M83 64A38 38 0 0 1 63 84" stroke="var(--red)"/>
        <path d="M76 60A30 30 0 0 1 60 77" stroke="var(--purple)"/>
        <circle cx="48" cy="48" r="17" stroke="var(--line-hover)"/>
      </g>
      <path class="player__curve" data-disc-target="curve"/>
      <path class="player__comet" data-disc-target="comet"/>
    </svg>
    <span class="player__hole">
      <svg class="player__icon player__icon--play" viewBox="0 0 16 16"><path d="M5 3v10l8-5z"/></svg>
      <svg class="player__icon player__icon--pause" viewBox="0 0 16 16"><rect x="3.5" y="3" width="3" height="10" rx="1.2"/><rect x="9.5" y="3" width="3" height="10" rx="1.2"/></svg>
    </span>
  </button>
</div>
