<% content_for :title, "Start · Manimator" %>

<%# Onboarding (/start), as a story. π drops into a vector field, and as you go you meet friends who
    each show you something and bring a tool with them: ∫ the examples, { } the code, ∞ your buddy, Σ the board. The
    editor assembles itself around you as they arrive, and you leave with a signed Pledge and your idea in the editor. %>
<div class="story" data-controller="story"
     data-story-poses-value="<%= pi_pose_urls %>"
     data-story-prizes-value="<%= onboarding_prizes.map { |p| p.slice(:id, :name, :videos).merge(image: image_path(p[:image])) }.to_json %>"
     data-story-slots-value="<%= Pledge::SLOTS.to_json %>"
     data-story-days-value="<%= onboarding_days.to_json %>"
     data-story-sessions-value="<%= onboarding_sessions.to_json %>"
     data-story-classes-value="<%= onboarding_classes.map { |key, c| { key:, label: c[:label] } }.to_json %>"
     data-story-draw-url-value="<%= draw_ideas_path %>"
     data-story-claim-url-value="<%= claim_idea_path("ID") %>"
     data-story-pledge-url-value="<%= pledge_path %>"
     data-story-hours-value="<%= Pledge::HOURS_PER_VIDEO %>"
     data-story-scenes-url-value="<%= scenes_path %>"
     data-story-editor-url-value="<%= editor_path(view: "code") %>">
  <canvas class="story__canvas" data-story-target="canvas" aria-hidden="true"></canvas>

  <header class="story__bar" data-story-target="bar">
    <%= link_to "Manimator", root_path, class: "onboard__brand" %>
    <span class="onboard__slash">/</span>
    <span class="story__file">scene</span>
  </header>

  <%# The friends you'll meet, as silhouettes until you do: the editor's rail, one tool each (FriendsHelper). %>
  <nav class="story__rail" data-story-target="rail" aria-label="Friends you've met">
    <% FriendsHelper::FRIENDS.each do |view, friend| %>
      <div class="story__slot" data-friend="<%= friend[:id] %>" data-view="<%= view %>">
        <span class="story__glyph"><%= friend_glyph(view) %></span><span class="story__tool"><%= view %></span>
      </div>
    <% end %>
  </nav>

  <section class="story__code" data-story-target="code" aria-label="The code for this scene"></section>

  <div class="story__timeline" aria-hidden="true">
    <div class="tl__bar story__tl-bar"><span class="tl__play">▶</span><span class="tl__time">0.00<span class="c-faint"> / 0.00s</span></span></div>
    <div class="story__clips" data-story-target="timeline"></div>
  </div>

  <div class="story__cast" data-story-target="cast"></div>

  <section class="story__dialog" data-story-target="dialog" aria-live="polite">
    <div class="story__portrait" data-story-target="portrait"></div>
    <div class="story__speech">
      <span class="story__name" data-story-target="name"></span>
      <p class="story__text" data-story-target="text"></p>
      <div class="story__choices" data-story-target="choices"></div>
    </div>
    <span class="story__next" data-story-target="next" aria-hidden="true">▾</span>
    <button type="button" class="story__skip" data-story-target="skip" data-action="story#skip" hidden>skip ▸▸</button>
    <button type="button" class="story__skip" data-story-target="back" data-action="story#back" hidden>◂ back</button>
  </section>
</div>

<%= render "onboarding/player" %>
