<% content_for :title, "π's email · Manimator" %>
<main style="min-height: 100vh; display: grid; place-items: center; padding: 24px;">
  <section class="card" style="max-width: 520px; padding: 32px; gap: 20px;">
    <% if @visit.unsubscribed_at %>
      <h1 style="margin: 0; font-weight: 400;">Done. π won't email you again.</h1>
      <p class="muted" style="margin: 0;">Your spot in the story is still saved if you want it.</p>
      <%= link_to "Back to the story", onboarding_path, class: "btn btn--ghost" %>
    <% else %>
      <h1 style="margin: 0; font-weight: 400;">Stop π's email?</h1>
      <p class="muted" style="margin: 0;">π only sends one, and you won't hear from it again.</p>
      <%= button_to "Unsubscribe", visit_unsubscribe_path(@visit.followup_token), class: "btn btn--primary" %>
    <% end %>
  </section>
</main>
